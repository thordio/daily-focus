{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-pro",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 30,
    "enrichment_concurrency": 30,
    "languages": [
      "zh",
      "en"
    ]
  },
  "email": {
    "enabled": false,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "email_address": "daily-focus@example.com",
    "sender_name": "Daily Focus",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100
    },
    "rss": [
      {
        "name": "HuggingFace Daily Papers",
        "url": "https://huggingface.co/papers/feed.xml",
        "enabled": false,
        "max_items": 30,
        "category": "ai-research",
        "topic": "ai-tech"
      },
      {
        "name": "MarketWatch Top Stories",
        "url": "https://feeds.content.dowjones.io/public/rss/mw_topstories",
        "enabled": true,
        "max_items": 30,
        "category": "business",
        "topic": "economy"
      },
      {
        "name": "SeekingAlpha All Articles",
        "url": "https://seekingalpha.com/feed.xml",
        "enabled": true,
        "max_items": 30,
        "category": "investing",
        "topic": "economy"
      },
      {
        "name": "ArXiv cs.AI",
        "url": "https://rss.arxiv.org/rss/cs.AI",
        "enabled": true,
        "max_items": 50,
        "category": "ai-research",
        "topic": "ai-tech"
      },
      {
        "name": "ArXiv cs.CL",
        "url": "https://rss.arxiv.org/rss/cs.CL",
        "enabled": true,
        "max_items": 50,
        "category": "ai-research",
        "topic": "ai-tech"
      },
      {
        "name": "机器之心",
        "url": "https://www.jiqizhixin.com/rss",
        "enabled": true,
        "max_items": 30,
        "category": "ai-news",
        "topic": "ai-tech"
      },
      {
        "name": "量子位",
        "url": "https://www.qbitai.com/feed",
        "enabled": true,
        "max_items": 30,
        "category": "ai-news",
        "topic": "ai-tech"
      },
      {
        "name": "TechCrunch",
        "url": "https://techcrunch.com/feed/",
        "enabled": true,
        "max_items": 30,
        "category": "tech-news",
        "topic": "ai-markets"
      },
      {
        "name": "The Verge",
        "url": "https://www.theverge.com/rss/index.xml",
        "enabled": true,
        "max_items": 30,
        "category": "tech-news",
        "topic": "ai-markets"
      },
      {
        "name": "36氪",
        "url": "https://36kr.com/feed",
        "enabled": true,
        "max_items": 30,
        "category": "tech-news",
        "topic": "ai-markets"
      },
      {
        "name": "CNBC Technology",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=19854910",
        "enabled": true,
        "max_items": 30,
        "category": "business",
        "topic": "ai-markets"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 25,
          "min_score": 50
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 25,
          "min_score": 20
        },
        {
          "subreddit": "singularity",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 25,
          "min_score": 50
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "openbb": {
      "enabled": false,
      "watchlists": [],
      "fetch_filings": false,
      "filings_provider": "sec"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript",
        "Rust"
      ],
      "keywords": [
        "ai",
        "machine-learning",
        "llm",
        "deep-learning"
      ],
      "min_stars": 10,
      "max_items": 30
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "filtering": {
    "ai_score_threshold": 4.0,
    "time_window_hours": 24,
    "pre_score_max_per_topic": 50,
    "topic_limits": {
      "ai-tech": {
        "min": 6,
        "max": 10
      },
      "ai-markets": {
        "min": 6,
        "max": 10
      },
      "economy": {
        "min": 5,
        "max": 7
      }
    }
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null
  }
}